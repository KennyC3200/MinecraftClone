# Formatting rules for clangd / clang-format (used by VS Code's Format commands
# and VSCodeVim's = operator). Without this file clangd falls back to plain LLVM
# style: 2-space indents, `int *a`, 80 columns.
BasedOnStyle: LLVM

# One tab per indent level. Spaces are only used to align things, so the code
# looks right at any tab width.
UseTab: AlignWithSpaces
IndentWidth: 4
TabWidth: 4
ColumnLimit: 100

# `public:` / `private:` flush with `class`
AccessModifierOffset: -4

# `int* a`, `const std::string& name`
DerivePointerAlignment: false
PointerAlignment: Left

# Engine::Engine()
#     : m_window(1280, 720)
#     , m_shader(...)
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never

# Long calls break after `(` and indent the arguments one level, instead of
# aligning them under the `(`
AlignAfterOpenBracket: AlwaysBreak

# Only in-class one-liners (`GLuint Handle() const { ... }`) and empty bodies
# stay on one line
AllowShortFunctionsOnASingleLine: Inline

# `template <GLenum Target>` on its own line
AlwaysBreakTemplateDeclarations: Yes

# Close namespaces with a bare `}` (no `// namespace mcc` comment)
FixNamespaceComments: false
